<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ru.itone.illya4gurenko.repository.GruRejectTabRepository">

    <sql id="rejectInsertColumns">
        ID,
        SYSTEMACCOUNT,
        VISTA_TAB_ID,
        UTERRARIO,
        OLDTBAL,
        NEWTBAL,
        FRONT_TIMESTAMP,
        FRONT_STATUS,
        REJECT_DESC,
        CHECK_STATUS,
        CHECK_DESC,
        CHECK_USER,
        CHECK_TIMESTAMP,
        SVFE_LOAD_ID
    </sql>

    <sql id="rejectInsertValuesTail">
        #{systemAccount},
        #{vistaTabId},
        #{uterrario},
        #{oldTBal},
        #{newTBal},
        #{frontTimestamp},
        #{frontStatus},
        #{rejectDesc},
        #{checkStatus},
        #{checkDesc},
        #{checkUser},
        #{checkTimestamp},
        #{svfeLoadId}
    </sql>

    <insert id="save">
        <selectKey keyProperty="id"
                   resultType="java.lang.Long"
                   order="BEFORE">
            SELECT GRU.GRU_REJECT_SEQ.NEXTVAL
            FROM DUAL
        </selectKey>

        INSERT INTO GRU.GRU_REJECT_TAB (
        <include refid="rejectInsertColumns"/>
        )
        VALUES (
        #{id},
        <include refid="rejectInsertValuesTail"/>
        )
    </insert>

    <!-- пакетная вставка записи брака без дополнительного selectKey запроса к DUAL -->
    <insert id="saveBatchItem">
        INSERT INTO GRU.GRU_REJECT_TAB (
        <include refid="rejectInsertColumns"/>
        )
        VALUES (
        GRU.GRU_REJECT_SEQ.NEXTVAL,
        <include refid="rejectInsertValuesTail"/>
        )
    </insert>

    <select id="findAll" resultMap="GruRejectTabMap">
        SELECT
        ID, SYSTEMACCOUNT, VISTA_TAB_ID, UTERRARIO, OLDTBAL, NEWTBAL,
        FRONT_TIMESTAMP, FRONT_STATUS, REJECT_DESC, CHECK_STATUS,
        CHECK_DESC, CHECK_USER, CHECK_TIMESTAMP, SVFE_LOAD_ID
        FROM GRU.GRU_REJECT_TAB
    </select>

    <resultMap id="GruRejectTabMap" type="GruRejectTab" autoMapping="true">
        <id property="id" column="ID"/>
        <result property="systemAccount" column="SYSTEMACCOUNT"/>
        <result property="oldTBal" column="OLDTBAL"/>
        <result property="newTBal" column="NEWTBAL"/>
    </resultMap>
</mapper>
