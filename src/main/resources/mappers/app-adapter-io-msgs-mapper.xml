<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ru.itone.illya4gurenko.repository.AppAdapterIoMsgsRepository">

    <!-- сохраняет запись входящего или исходящего json-сообщения без суррогатного id -->
    <insert id="save">
        INSERT INTO ACC_APP_ADAPTER.APP_ADAPTER_IO_MSGS (
        TRANS_ID,
        MSG_TYPE,
        DIR,
        MSG,
        INS_TS,
        NODE_ID
        )
        VALUES (
        #{transId},
        #{msgType},
        #{dir},
        #{msg},
        #{insTs},
        #{nodeId}
        )
    </insert>

    <!-- возвращает все записи аудита сообщений -->
    <select id="findAll" resultMap="AppAdapterIoMsgsMap">
        SELECT
        TRANS_ID, MSG_TYPE, DIR, MSG, INS_TS, NODE_ID
        FROM ACC_APP_ADAPTER.APP_ADAPTER_IO_MSGS
    </select>

    <resultMap id="AppAdapterIoMsgsMap" type="AppAdapterIoMsgs" autoMapping="true"/>
</mapper>